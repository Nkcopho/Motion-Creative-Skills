{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "motion",
  "type": "object",
  "properties": {
    "duration_s": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "fps": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "channels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "object_id",
          "property",
          "start_s",
          "end_s",
          "depends_on",
          "keyframes",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "object_id": {
            "type": "string",
            "minLength": 1
          },
          "property": {
            "type": "string",
            "minLength": 1
          },
          "start_s": {
            "type": "number",
            "minimum": 0
          },
          "end_s": {
            "type": "number",
            "minimum": 0
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "keyframes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "t",
                "value"
              ],
              "properties": {
                "t": {
                  "type": "number",
                  "minimum": 0
                },
                "value": {}
              }
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "class",
                "source",
                "locator",
                "method",
                "limitations"
              ],
              "properties": {
                "class": {
                  "enum": [
                    "VERIFIED",
                    "MEASURED",
                    "ESTIMATED",
                    "INFERRED",
                    "PROPOSED",
                    "UNKNOWN"
                  ]
                },
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "locator": {
                  "type": "string",
                  "minLength": 1
                },
                "method": {
                  "type": "string",
                  "minLength": 1
                },
                "limitations": {
                  "type": "string"
                },
                "units": {
                  "type": "string"
                },
                "value": {},
                "uncertainty": {}
              }
            }
          }
        }
      }
    }
  },
  "required": [
    "duration_s",
    "fps",
    "channels"
  ],
  "additionalProperties": true
}
