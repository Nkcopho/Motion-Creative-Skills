{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "brief",
  "type": "object",
  "properties": {
    "project": {
      "type": "string",
      "minLength": 1
    },
    "product": {
      "type": "string",
      "minLength": 1
    },
    "audience": {
      "type": "string",
      "minLength": 1
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "emotion": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "brand_constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "duration_s": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "format": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "analyse",
        "develop",
        "implement",
        "evaluate",
        "full"
      ]
    },
    "comparison_mode": {
      "enum": [
        "reconstruction",
        "transfer"
      ]
    },
    "renderer": {
      "type": "string",
      "minLength": 1
    },
    "references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "project",
    "product",
    "audience",
    "goal",
    "mode",
    "comparison_mode"
  ],
  "additionalProperties": true
}
