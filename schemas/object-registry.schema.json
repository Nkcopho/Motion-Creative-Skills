{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "object-registry",
  "type": "object",
  "properties": {
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "role",
          "geometry",
          "material",
          "relationships",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "geometry": {
            "type": "object"
          },
          "material": {
            "type": "string",
            "minLength": 1
          },
          "relationships": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "class",
                "source",
                "locator",
                "method",
                "limitations"
              ],
              "properties": {
                "class": {
                  "enum": [
                    "VERIFIED",
                    "MEASURED",
                    "ESTIMATED",
                    "INFERRED",
                    "PROPOSED",
                    "UNKNOWN"
                  ]
                },
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "locator": {
                  "type": "string",
                  "minLength": 1
                },
                "method": {
                  "type": "string",
                  "minLength": 1
                },
                "limitations": {
                  "type": "string"
                },
                "units": {
                  "type": "string"
                },
                "value": {},
                "uncertainty": {}
              }
            }
          },
          "parent_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "screen_bounds": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4
          }
        }
      }
    }
  },
  "required": [
    "objects"
  ],
  "additionalProperties": true
}
