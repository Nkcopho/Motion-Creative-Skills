{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "class",
    "source",
    "locator",
    "method",
    "limitations"
  ],
  "properties": {
    "class": {
      "enum": [
        "VERIFIED",
        "MEASURED",
        "ESTIMATED",
        "INFERRED",
        "PROPOSED",
        "UNKNOWN"
      ]
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "locator": {
      "type": "string",
      "minLength": 1
    },
    "method": {
      "type": "string",
      "minLength": 1
    },
    "limitations": {
      "type": "string"
    },
    "units": {
      "type": "string"
    },
    "value": {},
    "uncertainty": {}
  }
}
